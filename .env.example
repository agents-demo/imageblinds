# --- model endpoint -------------------------------------------------------- #
# API_KEY is the only required variable; everything below has defaults
# (see imageblinds/settings.py) and can be left unset.
MODEL_PROVIDER=OpenAI
API_BASE=https://api.deepseek.com
API_KEY=your-api-key-here
# MODEL_NAME is taketwo's text-agent model; this app only uses VISION_MODEL_NAME.
MODEL_NAME=
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
LLM_TEMPERATURE=0.2
VISION_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_RETRIES=2
LLM_SSL_VERIFY=false

# --- narration voice ------------------------------------------------------- #
# Free Microsoft neural voice used by /api/tts (edge-tts). Requires internet.
# Other examples: en-GB-SoniaNeural, en-US-AndrewNeural, en-AU-NatashaNeural.
TTS_VOICE=en-US-AvaNeural
