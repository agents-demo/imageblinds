# --- model endpoint (required to run analysis) ----------------------------- #
MODEL_PROVIDER=OpenAI
API_BASE=https://api.deepseek.com
API_KEY=your-api-key-here
# MODEL_NAME is taketwo's text-agent model; this app only uses VISION_MODEL_NAME.
MODEL_NAME=
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
LLM_TEMPERATURE=0.2
VISION_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_RETRIES=2
LLM_SSL_VERIFY=false
